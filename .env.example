# OpenProject image configuration
OPENPROJECT_TAG=17-slim
POSTGRES_VERSION=17

# Local-first access defaults
OPENPROJECT_HTTPS=false
OPENPROJECT_HOST__NAME=127.0.0.1:8080
OPENPROJECT_ADDITIONAL__HOST__NAMES=localhost,web
OPENPROJECT_HSTS=false
PORT=127.0.0.1:8080
OPENPROJECT_RAILS__RELATIVE__URL__ROOT=
OPENPROJECT_URL=http://web:8080
COLLABORATIVE_SERVER_URL=ws://127.0.0.1:8080/hocuspocus
COLLABORATIVE_SERVER_SECRET=change-me-collab-secret

# Rails / app tuning
IMAP_ENABLED=false
RAILS_MIN_THREADS=4
RAILS_MAX_THREADS=16

# Secrets and database
SECRET_KEY_BASE=replace-with-a-real-secret
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-real-db-password
POSTGRES_DB=openproject
DATABASE_URL=postgres://postgres:replace-with-a-real-db-password@db/openproject?pool=20&encoding=unicode&reconnect=true

# Persistent storage
PGDATA=pgdata
OPDATA=opdata
OLLAMA_DATA=ollama

# Optional proxy profile
ENABLE_PROXY=false
PROXY_PORT=127.0.0.1:8081

# LLM mode selection
# Set LOCAL_MODEL to use the host's Ollama instance.
LOCAL_MODEL=

# Set CONTAINER_MODEL to run Ollama in Docker and pull the model if needed.
CONTAINER_MODEL=

# If neither LOCAL_MODEL nor CONTAINER_MODEL is set, scripts default to in-container llama3:8b.
DEFAULT_LOCAL_MODEL=llama3:8b
HOST_OLLAMA_BASE_URL=http://host.docker.internal:11434
HOST_OLLAMA_HEALTH_PATH=/api/tags
